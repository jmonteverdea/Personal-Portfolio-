# Copy this file to .env.local and fill in what you have.
# Nothing here is ever sent to the browser.

# Coaching, scenario generation and drill generation (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pronunciation scoring (Azure portal > Speech resource > Keys and Endpoint)
AZURE_SPEECH_KEY=
# The resource's region, for example eastus or westeurope
AZURE_SPEECH_REGION=
